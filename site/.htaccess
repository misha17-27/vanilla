# Vanilla Cake — все не-файловые запросы через router.php (URL-структура как у WordPress)
RewriteEngine On
RewriteBase /

# Файлы страниц лежат в корне, и Apache отдаёт их напрямую в обход router.php.
# Получались вторые копии тех же страниц (/about.php и /haqqimizda/), поэтому
# уводим каждый файл на его настоящий адрес.
RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
RewriteRule ^index\.php$ / [R=301,L]
RewriteRule ^about\.php$       /haqqimizda/        [R=301,L]
RewriteRule ^bento\.php$       /bolme/bento-tort/  [R=301,L]
RewriteRule ^cake-to-go\.php$  /bolme/cake-to-go/  [R=301,L]
RewriteRule ^contact\.php$     /elaqe/             [R=301,L]
RewriteRule ^faq\.php$         /faq/               [R=301,L]
RewriteRule ^fillings\.php$    /terkibler/         [R=301,L]
RewriteRule ^konstruktor\.php$ /konstruktor/       [R=301,L]
RewriteRule ^reviews\.php$     /reyler/            [R=301,L]
RewriteRule ^sitemap\.php$     /sitemap.xml        [R=301,L]

# Главная тоже идёт через router.php: иначе Apache отдаёт index.php сам
# и ?lang=xx на ней не превращается в /az/ и /en/
RewriteRule ^$ router.php [L]

# Адрес каталога (/assets/, /uploads/) тоже уходит в router.php — он ответит 404.
# Файлы внутри каталогов отдаёт сам Apache: они проходят по условию -f.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ router.php [L]

# Сжатие текстовых ответов
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# Кэширование статики
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>
